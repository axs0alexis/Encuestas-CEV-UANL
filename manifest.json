{
  "manifest_version": 3,
  "name": "Encuestas CEV",
  "version": "1.0",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://deimos.dgi.uanl.mx/*"
  ],
  "icons": {
    "48": "assets/icon64.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "assets/icon64.png",
      "128": "assets/icon128.png"
    }
  }
}